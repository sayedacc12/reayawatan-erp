{
  "name": "charity-erp-backend",
  "version": "1.0.0",
  "description": "Sanabel ERP backend (NestJS modular monolith)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "migration:generate": "npm run typeorm -- migration:generate -d src/config/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/config/data-source.ts",
    "migration:run:prod": "typeorm migration:run -d dist/config/data-source.js",
    "typeorm": "typeorm-ts-node-commonjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest --runInBand"
  },
  "license": "ISC",
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@nestjs/common": "^10.4.22",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/throttler": "^5.2.0",
    "@nestjs/typeorm": "^10.0.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "exceljs": "^4.4.0",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "puppeteer-core": "^24.43.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.22",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true,
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "overrides": {
    "multer": "^2.5.0",
    "body-parser": "^1.20.9",
    "lodash": "^4.18.1",
    "qs": "^6.17.1",
    "basic-ftp": "^6.2.6",
    "zod": "^4.6.7"
  }
}
