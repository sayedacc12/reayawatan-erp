# مثال: موقع ثابت على example.com، وتحويل www إليه، ونظام آخر على erp.example.com.
# انسخه باسم ينتهي بـ .caddy وعدّل الدومينات والمسارات.

www.example.com {
	redir https://example.com{uri} permanent
}

example.com {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	root * /etc/caddy/sites/example/www
	file_server
}

# نظام في مجلد آخر، خدمته "example-frontend" موصولة بالشبكة caddy-edge:
# erp.example.com {
# 	encode gzip
# 	reverse_proxy example-frontend:80
# }
